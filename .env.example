# ===================================================================
# RethoricalAI - Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and fill in your confidential values.
# NEVER commit .env, .env.local, or credentials files to source control.
# ===================================================================

# --- Frontend Environment Variables (Vite prefixed with VITE_) ---
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.rethoricalai.edu
VITE_JWT_SECRET_KEY=your_secure_random_jwt_signing_key_here

# --- Backend Environment Variables ---
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET_KEY=your_backend_jwt_secret_key_here

# --- LMS Integration Credentials ---
GOOGLE_CLASSROOM_CLIENT_ID=your_google_classroom_client_id
GOOGLE_CLASSROOM_CLIENT_SECRET=your_google_classroom_client_secret
CANVAS_API_URL=https://canvas.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token_here
MOODLE_URL=https://moodle.yourinstitution.edu
MOODLE_WS_TOKEN=your_moodle_web_service_token_here
BLACKBOARD_REST_KEY=your_blackboard_rest_key_here
BLACKBOARD_REST_SECRET=your_blackboard_rest_secret_here

# --- Rate Limiting & Security ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_SECONDS=60
